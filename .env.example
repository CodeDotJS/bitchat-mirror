REPO=permissionlesstech/bitchat-android
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bitchat-mirror
R2_PUBLIC_BASE=https://pub-xxxxxxxx.r2.dev
MIRROR_POLICY=smart
MAX_BYTES=10200547328
LOG_LEVEL=INFO
# Required for local runs — anonymous quota is 60 req/h and burns fast.
# In GitHub Actions, GITHUB_TOKEN is injected automatically (5000 req/h).
GITHUB_TOKEN=
# Optional — used by research/scripts/archive_sources.py to fetch
# paywalled or geo-blocked pages into research/sources/raw/.
# Direct HTTPS is tried first for PDFs and open pages.
SCRAPINGBEE_API_KEY=
GROK_API_KEY=